# Siyaphi Backend - Local Development Environment
# Copy this to .env and fill in values

# ── Database ──────────────────────────────────────────────────────
DATABASE_URL="postgresql://siyaphi:siyaphi_local_dev@localhost:5432/siyaphi_dev?schema=public"

# ── App ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_NAME=siyaphi-backend
APP_VERSION=1.0.0

# ── Auth / JWT ────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change_this_to_a_random_secret_in_production_at_least_32_chars
JWT_EXPIRY=7d
DEVICE_TOKEN_SECRET=change_this_device_secret_too

# ── Redis (optional - falls back to in-memory if not set) ─────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_ENABLED=true

# ── Rate Limiting ─────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ── Crowd Report Settings ─────────────────────────────────────────
REPORT_EXPIRY_HOURS=4
REPORT_MIN_TRUST_SCORE=0.3
REPORT_DUPLICATE_WINDOW_MINUTES=10
REPORT_DUPLICATE_RADIUS_METERS=200

# ── Sync ──────────────────────────────────────────────────────────
SYNC_MANIFEST_CACHE_SECONDS=300

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_PRETTY=true

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for local dev
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,exp://localhost:8081

# ── WebSocket ─────────────────────────────────────────────────────
WS_MAX_CONNECTIONS=1000
WS_HEARTBEAT_INTERVAL=25000
